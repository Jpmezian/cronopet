# ─── CronoPet — PROD ENVIRONMENT ────────────────────────────────────────────
# Copie este arquivo para `.env.prod` e preencha com os valores de PRODUÇÃO.
# `.env.prod` é carregado quando você rode `npm run start:prod` ou builds production.
# Em CI/EAS, configure cada variável como EAS Secret (não commite `.env.prod` real).

APP_VARIANT=production

# OpenWeatherMap
EXPO_PUBLIC_OWM_KEY=

# Sentry — DSN do projeto PROD
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Supabase — projeto PROD
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat — public SDK keys de PROD (live)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog — analytics em PROD
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
