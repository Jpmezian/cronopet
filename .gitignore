# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — nunca commitar chaves de API
.env
.env.dev
.env.prod
.env*.local
# permitir commit dos templates
!.env.example
!.env.dev.example
!.env.prod.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
relatorio.md

# Claude Code local state
.claude/

# Supabase CLI local cache
supabase/.temp/
supabase/.branches/

# Docs internos — mantidos localmente, não vão pro remote público
LEGAL_RESEARCH_PROMPT.md
PRODUCT_OVERVIEW.md

# Credenciais Apple / Google / Supabase (locais)
*.p8
cronopet-credentials/

# Relatórios internos (CEO/CMO/etc) — privados
docs/reports/
