!.env.example
!.env.dev.example
!.env.prod.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
relatorio.md

# Claude Code local state
.claude/

# Supabase CLI local cache
supabase/.temp/
supabase/.branches/

# Docs internos — mantidos localmente, não vão pro remote público
LEGAL_RESEARCH_PROMPT.md
PRODUCT_OVERVIEW.md

# Credenciais Apple / Google / Supabase (locais)
*.p8
cronopet-credentials/

# Relatórios internos (CEO/CMO/etc) — privados
docs/reports/

# ── Briefings internos do CTO (untracked permanente) ─────────
# Material privado: roadmaps, decisões CTO, papéis de sócios.
# NUNCA commitar. Sprint anterior (Doc Visual) e Bold v3.
# Cleanup retroativo: 2026-06-14 (commit 1e08ce2 force-push rewrite).
#
# Globs cobrem Mac duplicate naming: ao baixar mesmo material 2+ vezes,
# Finder cria 'files 2/', 'files 3.zip', etc. Endurecido 2026-06-16
# após appearance de 'files 2/' antes do commit da Fase 1b.
/files*/
/files*.zip
