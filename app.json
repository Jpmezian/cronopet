{
  "expo": {
    "name": "CronoPet",
    "slug": "CronoPet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cronopet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFDF3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cronopet.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E9F1CF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cronopet.app",
      "usesCleartextTraffic": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para escolher a imagem do seu pet.",
          "cameraPermission": "Permita o acesso à câmera para tirar uma foto do seu pet."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita o acesso à localização para exibir o clima da sua região.",
          "locationWhenInUsePermission": "Permita o acesso à localização para exibir o clima da sua região.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#04A29B",
          "defaultChannel": "cronopet-daily",
          "iosDisplayInForeground": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "joao-pedro-mezian",
          "project": "cronopet"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
