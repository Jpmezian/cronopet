# ─── CronoPet — DEV ENVIRONMENT ─────────────────────────────────────────────
# Copie este arquivo para `.env.dev` e preencha os valores do projeto de DESENVOLVIMENTO.
# `.env.dev` é carregado quando você rode `npm run start:dev` ou `npm run ios:dev`.
# NUNCA misture chaves de prod aqui — esse ambiente deve apontar pra um Supabase separado.

APP_VARIANT=development

# OpenWeatherMap — pode reutilizar a mesma chave (free tier não tem rate por env)
EXPO_PUBLIC_OWM_KEY=

# Sentry — DSN do projeto DEV (crie um projeto separado no Sentry: cronopet-dev)
# Em desenvolvimento o Sentry está desabilitado via __DEV__, mas o DSN é necessário pra builds preview/staging.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Supabase — projeto DEV (separado do de produção!)
# Crie um segundo projeto no Supabase Dashboard chamado "cronopet-dev"
# e rode `supabase/migrations/001_rls_policies.sql` nele.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat — public SDK key do projeto DEV (sandbox)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog — analytics em ambiente DEV (project separado)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
