{
  "name": "cronopet",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:dev": "dotenv -e .env.dev -- expo start --clear",
    "start:prod": "dotenv -e .env.prod -- expo start --clear",
    "ios:dev": "dotenv -e .env.dev -- expo run:ios",
    "ios:prod": "dotenv -e .env.prod -- expo run:ios",
    "android:dev": "dotenv -e .env.dev -- expo run:android",
    "android:prod": "dotenv -e .env.prod -- expo run:android",
    "typecheck": "tsc --noEmit",
    "test:health":   "tsx __tests__/health-insights/run.ts",
    "test:calories": "tsx __tests__/calories/run.ts",
    "test:breeds":   "tsx __tests__/breeds/run.ts",
    "test:fuzzy":    "tsx __tests__/fuzzy/run.ts",
    "test:security": "tsx --tsconfig tsconfig.test.json __tests__/security/run.ts",
    "test:toast":    "tsx --tsconfig tsconfig.test.json __tests__/store/toast.run.ts",
    "test:pet":      "tsx --tsconfig tsconfig.test.json __tests__/store/pet.run.ts",
    "test:premium":  "tsx --tsconfig tsconfig.test.json __tests__/hooks/premium.run.ts",
    "test:triggers": "tsx --tsconfig tsconfig.test.json __tests__/hooks/premium-triggers.run.ts",
    "test:theme":    "tsx --tsconfig tsconfig.test.json __tests__/hooks/theme.run.ts",
    "test:motion":   "tsx --tsconfig tsconfig.test.json __tests__/hooks/motion.run.ts",
    "test:smart":    "tsx --tsconfig tsconfig.test.json __tests__/hooks/smart-notif.run.ts",
    "test:weather":  "tsx --tsconfig tsconfig.test.json __tests__/hooks/weather.run.ts",
    "test:copy":     "tsx __tests__/insight-personalization/run.ts",
    "test:sync":     "tsx __tests__/sync-mappers/run.ts",
    "test:pdf":      "tsx __tests__/pdf-helpers/run.ts",
    "test:all":      "npm run test:health && npm run test:calories && npm run test:breeds && npm run test:fuzzy && npm run test:security && npm run test:toast && npm run test:pet && npm run test:premium && npm run test:triggers && npm run test:theme && npm run test:motion && npm run test:smart && npm run test:weather && npm run test:copy && npm run test:sync && npm run test:pdf",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "test:e2e": "maestro test .maestro/"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.7.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.3",
    "react-native-mmkv": "^4.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "dotenv-cli": "^7.4.4",
    "knip": "^6.14.1",
    "tsx": "^4.22.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
